<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.bottomnavigation.BottomNavigationView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavigationView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/bg_dock_bar"
    android:elevation="8dp"
    app:elevation="8dp"
    app:itemIconTint="@color/nav_item_tint"
    app:itemTextColor="@color/nav_item_tint"
    app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
    app:labelVisibilityMode="labeled"
    app:menu="@menu/bottom_nav_menu" />
