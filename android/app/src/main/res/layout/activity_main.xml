<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@drawable/bg_premium_geometric">

    <!-- ============================================================ -->
    <!-- 1. واجهة التطبيق الرئيسية (Main Hub Screen - Modern PS Gaming) -->
    <!-- ============================================================ -->

    <!-- ============================================================ -->
    <!-- 2. واجهة داخل الغرفة (Active Room Screen - 2026 OLED Glassmorphism) -->
    <!-- ============================================================ -->
    <LinearLayout
        android:id="@+id/layout_room_active"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_premium_geometric"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <!-- Top bar: 3 very small frosted glass pill chips, icons ONLY no text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <!-- Chip 1: Lightning bolt icon -->
            <FrameLayout
                android:id="@+id/chip_lightning"
                android:layout_width="64dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_top_chip"
                android:layout_marginEnd="10dp">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_chip_lightning"
                    android:contentDescription="Latency Ping" />
            </FrameLayout>

            <!-- Chip 2: Crown icon with pink accents -->
            <FrameLayout
                android:id="@+id/chip_crown"
                android:layout_width="64dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_top_chip"
                android:layout_marginEnd="10dp">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_chip_crown"
                    android:contentDescription="Role Room Code" />
            </FrameLayout>

            <!-- Chip 3: Small green dot live indicator -->
            <FrameLayout
                android:id="@+id/chip_live"
                android:layout_width="64dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_top_chip">
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_live_green_dot" />
            </FrameLayout>
        </LinearLayout>

        <!-- Center: Large pure black game viewport #000000 with 28px rounded corners, thin 2px neon purple glowing border #A855F7 -->
        <FrameLayout
            android:id="@+id/game_viewport_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_game_viewport"
            android:clipToOutline="true"
            android:padding="2dp">

            <com.almahala.netplay.ui.SquareFrameLayout
                android:id="@+id/game_view_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000">

                <TextView
                    android:id="@+id/game_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="🎮 Combat 3 PS1 Arena\n\nمحاكي PlayStation 1 الأصلي جاهز للتشغيل والمزامنة التامة"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp" />

                <!-- Guest Live Remote Play Streaming View (Zero-ROM Client) -->
                <ImageView
                    android:id="@+id/game_stream_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </com.almahala.netplay.ui.SquareFrameLayout>

            <!-- Floating Stream Status Badge (Shows for Guest in Remote Play Mode) -->
            <LinearLayout
                android:id="@+id/layout_guest_stream_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_top_chip"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:visibility="gone">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_live_green_dot"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/txt_guest_stream_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="بث المضيف المباشر • أنت اللاعب 2"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Below game viewport: Floating frosted glass dock bar, pill shape, 56dp height, contains balanced outline icons without text -->
        <LinearLayout
            android:id="@+id/bottom_dock_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_dock_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <!-- 1. Settings Gear -->
            <ImageButton
                android:id="@+id/btn_dock_settings"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_dock_settings"
                android:contentDescription="Settings" />

            <!-- 2. Two people (room participants) -->
            <ImageButton
                android:id="@+id/btn_dock_members"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_dock_members"
                android:contentDescription="Room Members" />

            <!-- 3. Joystick gamepad -->
            <ImageButton
                android:id="@+id/btn_dock_gamepad"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_dock_gamepad"
                android:contentDescription="Gamepad Layout" />

            <!-- 4. Walkie-talkie radio -->
            <ImageButton
                android:id="@+id/btn_dock_voice"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_dock_voice"
                android:contentDescription="Voice Radio" />

            <!-- Mini Vertical Voice Audio Visualizer in the Dock -->
            <com.almahala.netplay.ui.VerticalVoiceMeterView
                android:id="@+id/voice_meter_dock"
                android:layout_width="12dp"
                android:layout_height="22dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp" />

            <!-- 5. Camera Toggle (Icon-only without text) -->
            <ImageButton
                android:id="@+id/btn_dock_camera"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_dock_camera"
                android:contentDescription="Camera Toggle" />

            <!-- 6. Chat bubble with dots -->
            <ImageButton
                android:id="@+id/btn_dock_chat"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_dock_chat"
                android:contentDescription="Chat" />
        </LinearLayout>

        <!-- Controller Spacer Area: Leaves ergonomic space for on-screen touch controller -->
        <View
            android:id="@+id/controller_spacer"
            android:layout_width="match_parent"
            android:layout_height="256dp" />
    </LinearLayout>

</FrameLayout>
