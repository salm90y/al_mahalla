<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/menuProfileMoreContainer"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_popup_glass"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:layoutDirection="rtl"
    android:elevation="12dp">

    <!-- 1. مشاركة الملف الشخصي -->
    <LinearLayout
        android:id="@+id/itemShareProfile"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_menu_item_ripple"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvShareProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:text="مشاركة الملف الشخصي"
            android:textColor="@color/token_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivShareProfile"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_share_profile"
            app:tint="@color/token_text_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#1FFFFFFF"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp" />

    <!-- 2. عرض رمز QR -->
    <LinearLayout
        android:id="@+id/itemShowQr"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_menu_item_ripple"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvShowQr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:text="عرض رمز QR"
            android:textColor="@color/token_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivShowQr"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_qr_code"
            app:tint="@color/token_text_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#1FFFFFFF"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp" />

    <!-- 3. بحث -->
    <LinearLayout
        android:id="@+id/itemSearch"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_menu_item_ripple"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:text="بحث"
            android:textColor="@color/token_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivSearch"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_search"
            app:tint="@color/token_text_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#1FFFFFFF"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp" />

    <!-- 4. كتم الإشعارات -->
    <LinearLayout
        android:id="@+id/itemMuteNotifications"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_menu_item_ripple"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvMuteNotifications"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:text="كتم الإشعارات"
            android:textColor="@color/token_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivMuteNotifications"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_bell"
            app:tint="@color/token_text_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#1FFFFFFF"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp" />

    <!-- 5. إشعارات مخصصة -->
    <LinearLayout
        android:id="@+id/itemCustomNotifications"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_menu_item_ripple"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvCustomNotifications"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:text="إشعارات مخصصة"
            android:textColor="@color/token_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCustomNotifications"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_bell"
            app:tint="@color/token_text_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#1FFFFFFF"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp" />

    <!-- 6. ظهور الوسائط -->
    <LinearLayout
        android:id="@+id/itemMediaVisibility"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_menu_item_ripple"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvMediaVisibility"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:text="ظهور الوسائط"
            android:textColor="@color/token_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivMediaVisibility"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_gallery"
            app:tint="@color/token_text_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#1FFFFFFF"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp" />

    <!-- 7. الرسائل ذاتية الاختفاء -->
    <LinearLayout
        android:id="@+id/itemDisappearingMessages"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_menu_item_ripple"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvDisappearingMessages"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:text="الرسائل ذاتية الاختفاء"
            android:textColor="@color/token_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivDisappearingMessages"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_timer_clock"
            app:tint="@color/token_text_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#1FFFFFFF"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp" />

    <!-- 8. معلومات التشفير -->
    <LinearLayout
        android:id="@+id/itemEncryptionInfo"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_menu_item_ripple"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvEncryptionInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:text="معلومات التشفير"
            android:textColor="@color/token_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivEncryptionInfo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_shield_neon"
            app:tint="@color/token_text_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#1FFFFFFF"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp" />

    <!-- 9. حظر -->
    <LinearLayout
        android:id="@+id/itemBlock"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_menu_item_ripple"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:text="حظر"
            android:textColor="@color/token_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivBlock"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_user_block"
            app:tint="@color/token_text_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#1FFFFFFF"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp" />

    <!-- 10. إبلاغ -->
    <LinearLayout
        android:id="@+id/itemReport"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_menu_item_ripple"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvReport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:text="إبلاغ"
            android:textColor="@color/token_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivReport"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_flag" />
    </LinearLayout>

</LinearLayout>
