<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Transparent Background (No background rect/box) -->

    <!-- Outer Gradient Neon Ring -->
    <path
        android:pathData="M 60,60 m -52,0 a 52,52 0 1,0 104,0 a 52,52 0 1,0 -104,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="10"
                android:startY="10"
                android:endX="110"
                android:endY="110">
                <item android:offset="0.0" android:color="#00D2D3" />
                <item android:offset="0.5" android:color="#0984E3" />
                <item android:offset="1.0" android:color="#6C5CE7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Dark Blue Circle -->
    <path
        android:pathData="M 60,60 m -46,0 a 46,46 0 1,0 92,0 a 46,46 0 1,0 -92,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="60"
                android:centerY="60"
                android:gradientRadius="46">
                <item android:offset="0.0" android:color="#0B1A3F" />
                <item android:offset="0.75" android:color="#050C22" />
                <item android:offset="1.0" android:color="#000615" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top Cyan Glow Crescent -->
    <path
        android:pathData="M 28,42 C 38,26 82,26 92,42 C 80,32 40,32 28,42 Z"
        android:fillColor="#3300D2D3" />

    <!-- Bottom Purple Glow Crescent -->
    <path
        android:pathData="M 28,78 C 38,94 82,94 92,78 C 80,88 40,88 28,78 Z"
        android:fillColor="#336C5CE7" />

    <!-- Stylized Arabic Calligraphy Path "المحلة" Center Piece -->
    <!-- Alef + Lam -->
    <path
        android:pathData="M 86,38 L 82,38 C 81,48 81,64 81,72 L 86,72 Z"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M 77,38 L 73,38 C 72,48 72,64 72,72 L 77,72 Z"
        android:fillColor="#FFFFFF" />

    <!-- Meem + Haa + Lam + Taa Marbuta Connecting Body -->
    <path
        android:pathData="M 73,70 C 65,70 54,67 48,67 C 42,67 36,70 32,70 C 30,70 28,68 28,65 C 28,60 33,56 40,56 C 47,56 50,60 56,60 C 62,60 67,54 73,54 Z"
        android:fillColor="#F1F2F6" />

    <!-- Taa Marbuta Loop & Dots -->
    <path
        android:pathData="M 38,54 C 44,54 44,46 38,46 C 32,46 32,54 38,54 Z"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M 35,42 A 2,2 0 1,0 39,42 A 2,2 0 1,0 35,42"
        android:fillColor="#00D2D3" />
    <path
        android:pathData="M 42,42 A 2,2 0 1,0 46,42 A 2,2 0 1,0 42,42"
        android:fillColor="#00D2D3" />
</vector>
